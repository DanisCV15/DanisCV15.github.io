---
import Base from '../layouts/Base.astro';
---
<Base title="Página no encontrada · Daniel Escolar" description="La página que buscas no existe o ha cambiado de dirección.">
  <div class="wrap">
    <section class="not-found">
      <p class="eyebrow">Error 404</p>
      <h1>Esta página no existe.</h1>
      <p class="lead">Puede que la dirección esté mal escrita o que la página haya cambiado de sitio. Desde la portada puedes buscar en todos los laboratorios.</p>
      <div class="actions">
        <a class="button primary" href="/index.html#laboratorios">Ir a los laboratorios</a>
        <a class="button" href="/index.html">Volver a la portada</a>
      </div>
    </section>
  </div>
</Base>
