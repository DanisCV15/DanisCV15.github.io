---
// Fuentes servidas desde la propia web (sin peticiones a Google): solo el subconjunto
// latino y los pesos que usa el CSS. Las dos más visibles se precargan para evitar saltos.
import '@fontsource/dm-sans/latin-400.css';
import '@fontsource/dm-sans/latin-600.css';
import '@fontsource/dm-sans/latin-700.css';
import '@fontsource/space-grotesk/latin-400.css';
import '@fontsource/space-grotesk/latin-700.css';
import dmSans400 from '@fontsource/dm-sans/files/dm-sans-latin-400-normal.woff2?url';
import spaceGrotesk700 from '@fontsource/space-grotesk/files/space-grotesk-latin-700-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  og?: { type: string; title: string; description: string; url: string; image?: string; imageAlt?: string };
  jsonld?: Record<string, unknown>;
  footer?: string;
  mainClass?: string;
  /** Marca la página para que Pagefind la indexe en el buscador. */
  searchable?: boolean;
}
const { title, description, og, jsonld, footer = 'Daniel Escolar · Ciberseguridad y desarrollo', mainClass, searchable = false } = Astro.props;
const abs = (p: string) => new URL(p, Astro.site).href;
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="description" content={description}>
  {og && (
    <>
      <link rel="canonical" href={og.url}>
      <meta property="og:type" content={og.type}>
      <meta property="og:site_name" content="Daniel Escolar">
      <meta property="og:locale" content="es_ES">
      <meta property="og:title" content={og.title}>
      <meta property="og:description" content={og.description}>
      <meta property="og:url" content={og.url}>
      {og.image && <meta property="og:image" content={abs(og.image)}>}
      {og.image && og.imageAlt && <meta property="og:image:alt" content={og.imageAlt}>}
      {og.image && <meta name="twitter:card" content="summary_large_image">}
    </>
  )}
  <title>{title}</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="sitemap" href="/sitemap-index.xml">
  <link rel="preload" href={dmSans400} as="font" type="font/woff2" crossorigin>
  <link rel="preload" href={spaceGrotesk700} as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/styles.css">
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...jsonld })} />}
</head>
<body>
  <a class="skip" href="#contenido">Saltar al contenido</a>
  <header class="nav">
    <div class="wrap">
      <a class="brand" href="/index.html">DE<b>.</b></a>
      <nav aria-label="Navegación principal">
        <a href="/index.html#perfil">Perfil</a>
        <a href="/index.html#proyectos">Proyectos</a>
        <a href="/index.html#laboratorios">Laboratorios</a>
        <a href="/index.html#contacto">Contacto ↗</a>
      </nav>
    </div>
  </header>
  <main id="contenido" class={mainClass} data-pagefind-body={searchable ? '' : undefined}>
    <slot />
  </main>
  <footer><div class="wrap">{footer}</div></footer>
  <slot name="scripts" />
</body>
</html>
